# Copy to .env and fill in. NEVER commit .env.
# ---- Database ----
DB_URL=jdbc:mysql://localhost:3306/farmconnect?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your_mysql_password

# ---- Seed admin (first startup only) ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe@123
ADMIN_EMAIL=you@example.com

# ---- Mail (optional; app works with this off) ----
MAIL_ENABLED=false
MAIL_USERNAME=
MAIL_PASSWORD=

# ---- Misc ----
PORT=9091
SHOW_SQL=false
